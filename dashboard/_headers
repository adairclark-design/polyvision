# Cloudflare Pages _headers
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# ── app.html must NEVER be cached ──────────────────────────────────────────────
# This is the entry-point HTML for the PolyVision dashboard. It references
# app.js?v=XX — if this file is cached, users get stale JS even after we push
# fixes. Setting no-cache forces a network revalidation on every load.
/app.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── index.html (landing page) — also keep fresh ────────────────────────────────
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/landing
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── Static assets — cache aggressively (they are versioned via ?v=XX or hash) ──
/app.js
  Cache-Control: public, max-age=31536000, immutable

/style.css
  Cache-Control: public, max-age=31536000, immutable
